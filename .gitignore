# decisiones y las salvaguardas
data/modelos/v3_2/validacion/ablacion/pred_*.csv.gz
data/modelos/v3_2/validacion/ablacion/escala_*.pkl

# lote de publicación incremental del artifact (python -m bbactualiza)
publicacion/
publicacion_completa/

# v5.1 (proceso paralelo de la temporada en curso): intermedios regenerables en cada actualización; se versiona sólo
