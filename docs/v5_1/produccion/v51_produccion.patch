+    CTX.liga = "feb1";                           // vara Primera FEB
+    o.c32 = convVara32(r, "fg3_pct"); o.c = convVara(r, "fg3_pct"); o.c5 = conv51(r, "fg3_pct", VARA51.metricas.fg3_pct);
